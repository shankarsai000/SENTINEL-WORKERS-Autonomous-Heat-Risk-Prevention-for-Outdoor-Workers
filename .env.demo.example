# Sentinel Workers — Deterministic Demo Configuration
# Optimized for reliable, zero-failure live presentations and judging demos.

NODE_ENV=development
PORT=3001
VITE_PORT=3000
DATABASE_PATH=./sentinel-demo.db
LOG_LEVEL=info
SYNTHETIC_SEED=42
SIMULATION_SPEED=1

# Allowed Origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Default to Offline Replay Mode for 100% Reliable Phoenix Heatwave Demo
THERMAL_DATA_MODE=offline

# FortyGuard API Parameters
FORTYGUARD_API_BASE_URL=https://api.fortyguard.com
FORTYGUARD_API_KEY=
FORTYGUARD_TIMEOUT_MS=10000
FORTYGUARD_POLL_INTERVAL_MS=1000
FORTYGUARD_MAX_POLL_ATTEMPTS=30
FORTYGUARD_CACHE_TTL_SECONDS=300

# Live Integration Gating
RUN_FORTYGUARD_LIVE_TESTS=false
