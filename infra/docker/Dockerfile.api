FROM node:22-alpine AS builder

WORKDIR /app

# Copy root configurations
COPY package.json tsconfig.json ./
COPY packages/ ./packages/
COPY providers/ ./providers/
COPY apps/api/ ./apps/api/

# Install dependencies and build
RUN npm install
RUN npm run build --workspace=@sentinel/schemas
RUN npm run build --workspace=@sentinel/policy
RUN npm run build --workspace=@sentinel/simulation
RUN npm run build --workspace=@sentinel/fortyguard-provider
RUN npm run build --workspace=@sentinel/api

FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3001
ENV DATABASE_PATH=/app/data/sentinel.db
ENV RISK_SERVICE_URL=http://risk-service:8000

COPY --from=builder /app /app

EXPOSE 3001

HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3001/api/health || exit 1

CMD ["node", "apps/api/dist/server.js"]
