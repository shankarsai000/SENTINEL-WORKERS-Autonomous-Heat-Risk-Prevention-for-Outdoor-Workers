# Sentinel Workers — Production-Like Configuration Template
# IMPORTANT: Never commit actual API keys or secrets to version control.

NODE_ENV=production
PORT=3001
VITE_PORT=3000
DATABASE_PATH=./data/sentinel.db
LOG_LEVEL=warn
SYNTHETIC_SEED=42

# Allowed CORS Origins (Comma-separated)
ALLOWED_ORIGINS=https://sentinel.worksite-safety.internal,http://localhost:3000

# Environmental Data Mode: "hybrid" | "fortyguard" | "offline"
THERMAL_DATA_MODE=hybrid

# FortyGuard Enterprise API (Injected via Kubernetes secret / vault in production)
FORTYGUARD_API_BASE_URL=https://api.fortyguard.com
FORTYGUARD_API_KEY=YOUR_SECURE_VAULT_INJECTED_KEY
FORTYGUARD_TIMEOUT_MS=8000
FORTYGUARD_POLL_INTERVAL_MS=1500
FORTYGUARD_MAX_POLL_ATTEMPTS=20
FORTYGUARD_CACHE_TTL_SECONDS=300

# Python ML Risk Service (Optional in-cluster container)
RISK_SERVICE_URL=http://risk-service:8000
