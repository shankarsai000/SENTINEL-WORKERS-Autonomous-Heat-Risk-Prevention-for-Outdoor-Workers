# Sentinel Workers - Environment Configuration
NODE_ENV=development
PORT=3001
VITE_PORT=3000
RISK_SERVICE_URL=http://localhost:8000
DATABASE_URL=file:./sentinel.db
SIMULATION_SPEED=1
LOG_LEVEL=info
SYNTHETIC_SEED=42

# Environmental Intelligence Data Mode: "offline" | "fortyguard" | "hybrid"
THERMAL_DATA_MODE=offline

# FortyGuard Enterprise API Configuration (v1.0.0)
# Note: NEVER commit real production API keys to source control.
FORTYGUARD_API_BASE_URL=https://api.fortyguard.com
FORTYGUARD_API_KEY=
FORTYGUARD_TIMEOUT_MS=10000
FORTYGUARD_POLL_INTERVAL_MS=1000
FORTYGUARD_MAX_POLL_ATTEMPTS=30
FORTYGUARD_CACHE_TTL_SECONDS=300

# Live Integration Gating (Optional)
RUN_FORTYGUARD_LIVE_TESTS=false
